FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tools/recovery-core.ts tools/recovery-backup.ts tools/recovery-job.ts ./tools/
RUN ./node_modules/.bin/esbuild tools/recovery-job.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/recovery-job.mjs
RUN npm prune --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
USER node
CMD ["node", "dist/recovery-job.mjs"]
