# local 僅限本機；Cloud Run 強制使用 firebase。不可將金鑰加入版本控制。
APP_MODE=local
PORT=8080
GOOGLE_CLOUD_PROJECT=
STORAGE_BUCKET=
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DAILY_USER_LIMIT=20
DAILY_GLOBAL_LIMIT=200
# Firebase public web config JSON（不是服務帳戶私鑰）
FIREBASE_WEB_CONFIG={}
FIREBASE_VAPID_KEY=
TASKS_LOCATION=asia-east1
TASKS_QUEUE=yaozhitong-ai
WORKER_URL=
WORKER_SERVICE_ACCOUNT=
SERVICE_ROLE=web
APP_URL=http://localhost:5173
