# local 僅限本機；Cloud Run 強制使用 firebase。不可將金鑰加入版本控制。
APP_MODE=local
AI_PROVIDER=openai
PORT=8080
GOOGLE_CLOUD_PROJECT=
STORAGE_BUCKET=
# 需要 NVIDIA 時改 AI_PROVIDER=nvidia，再填入對應金鑰。
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# 同一 NVIDIA 金鑰與端點；留白關閉備援，最多兩款，依序以逗號分隔。
NVIDIA_TEXT_FALLBACK_MODELS=z-ai/glm-5.3-flash
NVIDIA_VISION_FALLBACK_MODELS=z-ai/glm-5.3-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 預設使用 OpenAI，填入自己的後端金鑰；不會自動跨供應商傳送資料。
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# 生成／驗證／HTTP 重試均受期限與回應長度限制。
AI_REQUEST_TIMEOUT_MS=45000
AI_PRIMARY_TIMEOUT_MS=22000
# 文字主模型較早切換，為較慢的文字備援保留至少約33秒。
AI_TEXT_PRIMARY_TIMEOUT_MS=12000
AI_JOB_TIMEOUT_MS=120000
AI_TEXT_MAX_TOKENS=2400
AI_VISION_MAX_TOKENS=2600
DAILY_USER_LIMIT=20
DAILY_GLOBAL_LIMIT=200
# Firebase public web config JSON（不是服務帳戶私鑰）
FIREBASE_WEB_CONFIG={}
FIREBASE_VAPID_KEY=
TASKS_LOCATION=asia-east1
TASKS_QUEUE=yaozhitong-ai
WORKER_URL=
WORKER_SERVICE_ACCOUNT=
SERVICE_ROLE=web
APP_URL=http://localhost:5173
